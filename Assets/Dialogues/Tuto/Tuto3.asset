  m_Script: {fileID: 11500000, guid: 4215b2633c1f06f4fa8e2b46a201c92b, type: 3}
  m_Name: Tuto3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Directeur
  lines:
  - text: Chaque poisson que tu m'apporteras te rapportera de l'argent, que tu pourras
      utiliser en allant voir le marchand.
  - text: "Ah, et une derni\xE8re chose ! En sortant du camping, jette un oeil au
      tableau, tu comprendras. Et n'oublie pas le plus important, compl\xE8te ta
      collection !!!"
  - text: "Aller, \xE7a sera tout ! Passe une bonne nuit !"
