  m_Script: {fileID: 11500000, guid: 4215b2633c1f06f4fa8e2b46a201c92b, type: 3}
  m_Name: Tuto2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Directeur
  lines:
  - text: "Pour t'entra\xEEner, essaie d'aller p\xEAcher un poisson derri\xE8re toi
      !"
  - text: "En bas \xE0 gauche se trouvera ton compteur de lanc\xE9s, il se videra
      d\xE8s que ton lasso finit \xE0 la mer sans rapporter de poisson."
  - text: "Ne t'inqui\xE8te pas, pour aujourd'hui tu peux rater autant que tu veux
      !"
  - text: Aller, bonne chance !
