  m_Script: {fileID: 11500000, guid: 4215b2633c1f06f4fa8e2b46a201c92b, type: 3}
  m_Name: Tuto
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Marchant de poisson
  lines:
  - text: "Bien le bonjour ! Bienvenue pour ton premier jour en tant qu'employ\xE9
      !"
  - text: "Ton r\xF4le est d'attraper assez de poissons chaque jour.\nAttention,
      tu ne peux rater tes lanc\xE9s qu'un nombre limit\xE9 de fois !"
  - text: "Une fois l'objectif atteind, tu peux continuer \xE0 essayer d'attraper
      des poissons pour te faire plus d'argent,\npuis tu peux rentrer au camping.
      Il est sur la colline, la haut !"
